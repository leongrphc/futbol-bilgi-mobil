{
  "expo": {
    "name": "Football Link",
    "slug": "football-link",
    "version": "1.0.0",
    "scheme": "footballlink",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı seçebilmen için fotoğraflarına erişim gerekir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.footballlink.mvp",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.footballlink.mvp",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd933232-db21-4395-b7d9-501c04787a76"
      }
    },
    "owner": "mozkandev"
  }
}
