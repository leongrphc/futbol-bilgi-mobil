{
  "expo": {
    "name": "Football Link",
    "slug": "football-link",
    "scheme": "footballlink",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-av"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.footballlink.mvp",
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.footballlink.mvp"
    }
  }
}
