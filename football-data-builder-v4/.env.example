# Required for Wikidata imports. Use a real contact address.
WIKIDATA_USER_AGENT=FootballLinkDataBuilder/0.4 (contact: your-email@example.com)

# Required for Wikipedia category and footballer-page imports.
WIKIPEDIA_USER_AGENT=FootballLinkDataBuilder/0.4 (contact: your-email@example.com)
WIKIPEDIA_LANGUAGE=en

# Optional: current squads and recent transfers.
API_FOOTBALL_KEY=

FOOTBALL_DB_PATH=./data/football.db
